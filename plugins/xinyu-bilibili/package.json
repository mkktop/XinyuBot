{
  "name": "dsh-xinyu-bilibili",
  "version": "0.1.16",
  "description": "新雨机器人：自主浏览 B 站、在视频评论区 @ 大号推荐，并回复任何人对小号的提及",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "node --test tools/settings.test.mjs tools/guard.test.mjs tools/store.test.mjs tools/scan.test.mjs tools/scheduler.test.mjs tools/bridge.test.mjs && node tools/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "private": true
}
